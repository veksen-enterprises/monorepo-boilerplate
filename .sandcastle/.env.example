# Copy to .sandcastle/.env and fill in. NEVER commit the filled file.
#
# Generated by a human running `claude setup-token`. This is your Claude login —
# treat it like a password. Fine on your own machine for supervised runs; putting
# it on an always-on runner is a deliberate trust decision.
CLAUDE_CODE_OAUTH_TOKEN=

# Needs `repo` scope: the worker pushes a branch, opens a PR, and merges it.
# `gh auth token` works if your gh login has that scope.
GH_TOKEN=
